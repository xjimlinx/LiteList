{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litelist.local/schema/document-v2.json",
  "title": "LiteList cross-platform document",
  "type": "object",
  "required": ["version", "next_id", "tasks"],
  "properties": {
    "version": { "enum": [1, 2] },
    "next_id": { "$ref": "#/$defs/id" },
    "next_goal_id": { "$ref": "#/$defs/id" },
    "next_node_id": { "$ref": "#/$defs/id" },
    "tasks": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/task" }
    },
    "settings": {
      "type": "object",
      "description": "Platform-specific presentation state; portable features must not depend on it."
    },
    "notes": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/note" }
    },
    "goals": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/goal" }
    },
    "notifications": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/notification" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 253402214400000 },
    "nullableTimestamp": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "task": {
      "type": "object",
      "required": ["id", "text", "created_at", "completed_at", "deleted_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/nullableTimestamp" },
        "deleted_at": { "$ref": "#/$defs/nullableTimestamp" },
        "reminder": { "type": ["object", "null"] },
        "reminder_configured": { "type": "boolean" },
        "schedule_checked": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "required": ["id", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 200000 },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "visible": { "type": "boolean" },
        "topmost": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["id", "title", "nodes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/nullableTimestamp" },
        "terminated_at": { "$ref": "#/$defs/nullableTimestamp" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/goalNode" }
        }
      },
      "additionalProperties": false
    },
    "goalNode": {
      "type": "object",
      "required": ["id", "title", "requires"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "shape": { "type": "integer", "minimum": -1, "maximum": 2 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["task_id", "title", "text", "scheduled_at", "acknowledged"],
      "properties": {
        "task_id": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 12000 },
        "scheduled_at": { "type": "integer", "minimum": 0 },
        "acknowledged": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
